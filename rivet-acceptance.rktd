#hasheq(
 (version . 1)
 (requirements
  . (#hasheq((kind . contract) (platforms . (macos)))
     #hasheq((kind . bridge) (platforms . (macos)))
     #hasheq((kind . native-build) (platforms . (macos)))
     #hasheq((kind . native-ui) (platforms . (macos)))))
 (suites
  . (#hasheq((id . core-contract)
             (kind . contract)
             (platforms . (macos))
             (command . ("raco" "test" "tests/"))
             (timeout-seconds . 900))
     #hasheq((id . embedded-wire)
             (kind . bridge)
             (platforms . (macos))
             (command . ("raco" "test" "tests/backend.rkt"))
             (timeout-seconds . 300))
     #hasheq((id . native-host)
             (kind . native-build)
             (platforms . (macos))
             (command . ("raco" "rivet" "build"))
             (timeout-seconds . 1800))
     #hasheq((id . macos-native-ui)
             (kind . native-ui)
             (platforms . (macos))
             (command . ("bash" "scripts/e2e/e2e-macos.sh"))
             (timeout-seconds . 900)
             (evidence . (".rivet/acceptance/macos/interaction-trace.json"
                          ".rivet/acceptance/macos/accessibility.json"))))))
